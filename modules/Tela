def show_client_screen():
    query_params = st.query_params
    provider_token = query_params.get("prestador") or query_params.get("provider", None)

    if not provider_token:
        st.error("Tela inválida. Falta o parâmetro do prestador.")
        return

    st.markdown("""
    <style>
    .stApp { background-color: #000000; color: white; }
    </style>
    """, unsafe_allow_html=True)

    st.title("📺 FFKaraoke — Diagnóstico de Vídeo")
    st.markdown("---")

    try:
        response = requests.get(f"{FIREBASE_URL}/pedidos/{provider_token}.json")
        
        # --- DIAGNOSTICO 1: Ver o que o Firebase respondeu ---
        st.write("🔍 **Estado da Conexão Firebase:** HTTP", response.status_code)
        
        if response.status_code == 200 and response.json():
            data = response.json()
            st.write("📦 **Dados Brutos recebidos:**", data)
            
            pedidos = [{"id": k, **v} for k, v in data.items()]
            pedidos_ativos = [p for p in pedidos if p.get("estado") in ["pendente", "aprovado"]]
            
            tocando_agora = next((p for p in pedidos_ativos if p.get("estado") == "aprovado"), None)
            
            if tocando_agora:
                st.success("✅ Encontrou um pedido com estado 'aprovado'!")
                st.write("📄 Conteúdo completo do pedido aprovado:", tocando_agora)
                
                musica = tocando_agora.get("musica", {})
                st.write("🎶 Objeto 'musica' extraído:", musica, "Tipo:", type(musica))
                
                # Vamos extrair o link independentemente de vir como string ou dicionário
                if isinstance(musica, dict):
                    titulo = musica.get("titulo", "Sem Título")
                    url_video = musica.get("url_cloudinary") or musica.get("url") or ""
                else:
                    titulo = str(musica)
                    # Pode ser que o url esteja guardado noutra chave do pedido
                    url_video = tocando_agora.get("url_cloudinary", "")

                st.write(f"🎤 Título detetado: **{titulo}**")
                st.write(f"🔗 Link bruto do vídeo detetado: `{url_video}` (Tipo: {type(url_video)})")
                
                if url_video and str(url_video).startswith("http"):
                    st.success("✅ O link é válido e começa com http!")
                    st.video(url_video)
                else:
                    st.error("❌ **ERRO DESCOBERTO:** O link do vídeo está VAZIO, não começa com http ou está guardado numa chave errada no Firebase!")
            else:
                st.warning("⚠️ Nenhum pedido está com o estado 'aprovado' no Firebase. Vencido ou pendente.")
        else:
            st.info("A base de dados do Firebase para este prestador está vazia ou inacessível.")
            
    except Exception as e:
        st.error(f"❌ **ERRO CRÍTICO NO PYTHON:** {e}")

    # Sem o time.sleep e rerun para podermos ler o diagnóstico com calma no ecrã
    st.markdown("---")
    if st.button("🔄 Atualizar Diagnóstico Manualmente"):
        st.rerun()
